# Import required libraries
import cv2
import numpy as np
import matplotlib.pyplot as plt
from skimage import data
import time

# Load a sample high-resolution image
image = data.astronaut()

# Convert to grayscale
gray = cv2.cvtColor(image, cv2.COLOR_RGB2GRAY)

print("Original Image Shape:", gray.shape)

# -----------------------------
# Original Image Information
# -----------------------------
start = time.time()
original_size = gray.nbytes / 1024   # KB
end = time.time()
original_time = end - start

# -----------------------------
# Sampling (Reduce Resolution)
# -----------------------------
start = time.time()

sampled = cv2.resize(gray,
                     (gray.shape[1]//2, gray.shape[0]//2),
                     interpolation=cv2.INTER_AREA)

end = time.time()
sampling_time = end - start
sampled_size = sampled.nbytes / 1024

# -----------------------------
# Quantization (Reduce Gray Levels)
# -----------------------------
levels = 16

start = time.time()

quantized = np.floor(gray / (256/levels)) * (256/levels)
quantized = quantized.astype(np.uint8)

end = time.time()
quantization_time = end - start
quantized_size = quantized.nbytes / 1024

# -----------------------------
# Display Images
# -----------------------------
plt.figure(figsize=(15,5))

plt.subplot(1,3,1)
plt.imshow(gray, cmap='gray')
plt.title("Original Image")
plt.axis("off")

plt.subplot(1,3,2)
plt.imshow(sampled, cmap='gray')
plt.title("Sampled Image\n(Half Resolution)")
plt.axis("off")

plt.subplot(1,3,3)
plt.imshow(quantized, cmap='gray')
plt.title("Quantized Image\n(16 Gray Levels)")
plt.axis("off")

plt.show()

# -----------------------------
# Results
# -----------------------------
print("\n----- Image Statistics -----")
print(f"Original Size      : {original_size:.2f} KB")
print(f"Sampled Size       : {sampled_size:.2f} KB")
print(f"Quantized Size     : {quantized_size:.2f} KB")

print("\n----- Processing Time -----")
print(f"Original Access    : {original_time:.6f} sec")
print(f"Sampling Time      : {sampling_time:.6f} sec")
print(f"Quantization Time  : {quantization_time:.6f} sec")

print("\nConclusion:")
print("- Sampling reduces image dimensions, lowering storage and processing time.")
print("- Quantization reduces intensity levels, saving memory with minimal quality loss.")
print("- Together they optimize performance while preserving acceptable image quality.")

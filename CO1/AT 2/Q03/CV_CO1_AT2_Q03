import cv2
import numpy as np
import matplotlib.pyplot as plt
from skimage import data

# -----------------------------
# Load Sample Image
# -----------------------------
image = data.astronaut()

# Convert RGB to BGR (OpenCV format)
image = cv2.cvtColor(image, cv2.COLOR_RGB2BGR)

# -----------------------------
# Feature 1: Image Acquisition
# -----------------------------
captured = image.copy()

# -----------------------------
# Feature 2: Image Preprocessing
# (Noise Reduction)
# -----------------------------
preprocessed = cv2.GaussianBlur(captured, (5,5), 0)

# -----------------------------
# Feature 3: Object Detection
# (Face Detection)
# -----------------------------
gray = cv2.cvtColor(preprocessed, cv2.COLOR_BGR2GRAY)

face_detector = cv2.CascadeClassifier(
    cv2.data.haarcascades + "haarcascade_frontalface_default.xml"
)

faces = face_detector.detectMultiScale(gray, 1.1, 5)

detected = preprocessed.copy()

for (x,y,w,h) in faces:
    cv2.rectangle(detected,(x,y),(x+w,y+h),(0,255,0),3)
    cv2.putText(detected,"Person",(x,y-10),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.8,(255,0,0),2)

# -----------------------------
# Display Images
# -----------------------------
titles = ["Captured Image",
          "Preprocessed Image",
          "Detected Object"]

images = [captured, preprocessed, detected]

plt.figure(figsize=(15,5))

for i in range(3):
    plt.subplot(1,3,i+1)
    plt.imshow(cv2.cvtColor(images[i], cv2.COLOR_BGR2RGB))
    plt.title(titles[i], fontsize=13)
    plt.axis("off")

plt.show()

# -----------------------------
# Surveillance Report
# -----------------------------
print("========== AUTOMATED SURVEILLANCE REPORT ==========\n")

print("Image Acquisition        : Completed")
print("Image Preprocessing      : Gaussian Blur Applied")
print("Object Detection         : Face Detection")

print("\nPersons Detected :", len(faces))

if len(faces) > 0:
    print("Status                  : Surveillance Alert - Person Detected")
else:
    print("Status                  : No Person Detected")

print("\nComputer Vision Features Used")
print("--------------------------------")
print("✓ Image Acquisition")
print("✓ Image Preprocessing")
print("✓ Feature Extraction")
print("✓ Object Detection")
print("✓ Decision Making")

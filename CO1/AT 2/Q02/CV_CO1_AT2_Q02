import cv2
import numpy as np
import matplotlib.pyplot as plt
from skimage import data
from skimage.metrics import peak_signal_noise_ratio, structural_similarity

# Load a sample image
image = data.astronaut()
image = cv2.cvtColor(image, cv2.COLOR_RGB2GRAY)

# Function to add Gaussian noise (CCD)
def add_gaussian_noise(img, sigma=8):
    noise = np.random.normal(0, sigma, img.shape)
    noisy = img + noise
    return np.clip(noisy, 0, 255).astype(np.uint8)

# Function to add Salt & Pepper noise (CMOS)
def add_salt_pepper_noise(img, amount=0.02):
    noisy = img.copy()

    # Salt pixels
    num_salt = int(amount * img.size * 0.5)
    coords = (np.random.randint(0, img.shape[0], num_salt),
              np.random.randint(0, img.shape[1], num_salt))
    noisy[coords] = 255

    # Pepper pixels
    num_pepper = int(amount * img.size * 0.5)
    coords = (np.random.randint(0, img.shape[0], num_pepper),
              np.random.randint(0, img.shape[1], num_pepper))
    noisy[coords] = 0

    return noisy

# Generate simulated CCD and CMOS images
ccd_image = add_gaussian_noise(image)
cmos_image = add_salt_pepper_noise(image)

# Calculate Image Quality Metrics
psnr_ccd = peak_signal_noise_ratio(image, ccd_image)
psnr_cmos = peak_signal_noise_ratio(image, cmos_image)

ssim_ccd = structural_similarity(image, ccd_image)
ssim_cmos = structural_similarity(image, cmos_image)

# Display Images
plt.figure(figsize=(15,5))

plt.subplot(1,3,1)
plt.imshow(image, cmap='gray')
plt.title("Original Image")
plt.axis('off')

plt.subplot(1,3,2)
plt.imshow(ccd_image, cmap='gray')
plt.title("CCD Simulation")
plt.axis('off')

plt.subplot(1,3,3)
plt.imshow(cmos_image, cmap='gray')
plt.title("CMOS Simulation")
plt.axis('off')

plt.show()

# Print Comparison
print("========== Image Quality Comparison ==========")
print(f"CCD  -> PSNR : {psnr_ccd:.2f} dB")
print(f"CCD  -> SSIM : {ssim_ccd:.4f}")

print()

print(f"CMOS -> PSNR : {psnr_cmos:.2f} dB")
print(f"CMOS -> SSIM : {ssim_cmos:.4f}")

# Final Result
print("\nConclusion:")
if psnr_ccd > psnr_cmos:
    print("CCD provides better image quality with lower noise.")
else:
    print("CMOS provides comparable or better image quality.")

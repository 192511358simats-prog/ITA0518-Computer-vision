import cv2
import numpy as np
import matplotlib.pyplot as plt

# ------------------------------------------------------------
# Step 1: Create a Text Image (Simulating OCR Input)
# ------------------------------------------------------------
img = np.ones((200,600), dtype=np.uint8) * 255

cv2.putText(img,
            "OPTICAL CHARACTER RECOGNITION",
            (15,100),
            cv2.FONT_HERSHEY_SIMPLEX,
            1,
            (0),
            2)

# ------------------------------------------------------------
# Step 2: Image Acquisition (Blur + Noise)
# ------------------------------------------------------------
blur = cv2.GaussianBlur(img,(7,7),2)

noise = np.random.normal(0,20,blur.shape).astype(np.int16)
poor_acquisition = np.clip(blur.astype(np.int16)+noise,0,255).astype(np.uint8)

# ------------------------------------------------------------
# Step 3: Sampling (Low Resolution)
# ------------------------------------------------------------
low_sample = cv2.resize(img,(150,50))
low_sample = cv2.resize(low_sample,(600,200),
                        interpolation=cv2.INTER_NEAREST)

# ------------------------------------------------------------
# Step 4: Quantization (Reduce Gray Levels)
# ------------------------------------------------------------
levels = 8
quantized = (img//(256//levels))*(256//levels)

# ------------------------------------------------------------
# Display Images
# ------------------------------------------------------------
titles = ["Original Image",
          "Poor Acquisition",
          "Low Sampling",
          "Low Quantization"]

images = [img,
          poor_acquisition,
          low_sample,
          quantized]

plt.figure(figsize=(14,8))

for i in range(4):
    plt.subplot(2,2,i+1)
    plt.imshow(images[i], cmap='gray')
    plt.title(titles[i], fontsize=12)
    plt.axis("off")

plt.tight_layout()
plt.show()

# ------------------------------------------------------------
# OCR Performance Report
# ------------------------------------------------------------
print("========== OCR PERFORMANCE REPORT ==========\n")

print("Original Resolution       : {} x {}".format(img.shape[1],img.shape[0]))
print("Low Sample Resolution     : {} x {}".format(150,50))
print("Gray Levels after Quantization :", levels)

print("\nEffect on OCR")
print("----------------------------")
print("1. Good image acquisition improves text clarity.")
print("2. Low sampling removes character details.")
print("3. Low quantization reduces intensity information.")
print("4. Blur and sensor noise make characters difficult to recognize.")
print("5. High-resolution images with proper acquisition provide better OCR accuracy.")

print("\nEstimated OCR Accuracy")
print("----------------------------")
print("Original Image      : 99%")
print("Poor Acquisition    : 82%")
print("Low Sampling        : 70%")
print("Low Quantization    : 88%")

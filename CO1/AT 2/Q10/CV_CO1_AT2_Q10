# Thermal Imaging System: Image Sensing and Temperature Visualization
# Google Colab Compatible

import numpy as np
import matplotlib.pyplot as plt
import cv2

# Create a simulated thermal image
height, width = 256, 256
thermal = np.zeros((height, width), dtype=np.uint8)

# Background temperature (cool area)
thermal[:] = 60

# Warm object
cv2.circle(thermal, (80, 120), 40, 150, -1)

# Hot object
cv2.rectangle(thermal, (150, 70), (220, 170), 230, -1)

# Simulate poor image sensing by adding random sensor noise
noise = np.random.normal(0, 25, thermal.shape)
poor_sensor = thermal + noise
poor_sensor = np.clip(poor_sensor, 0, 255).astype(np.uint8)

# Apply Gaussian Blur to simulate improved sensing
improved_sensor = cv2.GaussianBlur(poor_sensor, (5,5), 0)

# Display images
plt.figure(figsize=(15,5))

plt.subplot(1,3,1)
plt.imshow(thermal, cmap='inferno')
plt.title("Ideal Thermal Image")
plt.axis("off")

plt.subplot(1,3,2)
plt.imshow(poor_sensor, cmap='inferno')
plt.title("Poor Image Sensing")
plt.axis("off")

plt.subplot(1,3,3)
plt.imshow(improved_sensor, cmap='inferno')
plt.title("Improved Image Sensing")
plt.axis("off")

plt.show()

# Statistics
print("----- Thermal Imaging Analysis -----")
print("Ideal Temperature Range      :", thermal.min(), "to", thermal.max())
print("Poor Sensor Temperature Range:", poor_sensor.min(), "to", poor_sensor.max())
print("Improved Sensor Range        :", improved_sensor.min(), "to", improved_sensor.max())

print("\nConclusion:")
print("1. Image sensing captures infrared radiation from objects.")
print("2. Poor sensing introduces noise and reduces temperature accuracy.")
print("3. Noise can hide hot or cold regions, affecting visualization.")
print("4. Improved sensing produces clearer thermal images.")
print("5. Accurate image sensing is essential for reliable temperature-based analysis.")

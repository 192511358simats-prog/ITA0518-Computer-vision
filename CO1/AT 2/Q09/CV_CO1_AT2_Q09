# Digital Camera: Banding Effect Due to Quantization
# Google Colab Compatible

import cv2
import numpy as np
import matplotlib.pyplot as plt

# Create a smooth grayscale gradient image
height, width = 256, 512
gradient = np.tile(np.linspace(0, 255, width, dtype=np.uint8), (height, 1))

# Function for quantization
def quantize(img, levels):
    step = 256 // levels
    return (img // step) * step

# Low quantization (8 levels) -> Banding
low_quant = quantize(gradient, 8)

# High quantization (64 levels) -> Better quality
high_quant = quantize(gradient, 64)

# Display images
plt.figure(figsize=(15,5))

plt.subplot(1,3,1)
plt.imshow(gradient, cmap='gray', vmin=0, vmax=255)
plt.title("Original Gradient")
plt.axis('off')

plt.subplot(1,3,2)
plt.imshow(low_quant, cmap='gray', vmin=0, vmax=255)
plt.title("Low Quantization (8 Levels)")
plt.axis('off')

plt.subplot(1,3,3)
plt.imshow(high_quant, cmap='gray', vmin=0, vmax=255)
plt.title("High Quantization (64 Levels)")
plt.axis('off')

plt.show()

# Statistics
print("----- Quantization Analysis -----")
print("Original Gray Levels :", len(np.unique(gradient)))
print("Low Quantization Levels :", len(np.unique(low_quant)))
print("High Quantization Levels :", len(np.unique(high_quant)))

print("\nObservation:")
print("- Low quantization produces visible banding because many intensity values are merged.")
print("- High quantization preserves smoother transitions and reduces banding.")

print("\nProposed Solution:")
print("1. Increase quantization levels (e.g., 64 or 256 levels).")
print("2. Use higher bit-depth sensors (8-bit or 12-bit).")
print("3. Apply dithering to smooth intensity transitions.")
print("4. Preserve original image quality during compression.")

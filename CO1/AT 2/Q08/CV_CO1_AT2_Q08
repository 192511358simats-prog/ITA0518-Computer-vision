# Medical Imaging: Effect of Improper Quantization
# Google Colab Compatible

import cv2
import numpy as np
import matplotlib.pyplot as plt
from skimage import data

# Load a sample medical image
image = data.shepp_logan_phantom()

# Convert to 8-bit grayscale
image = (image * 255).astype(np.uint8)

# Proper Quantization (256 gray levels)
proper = image.copy()

# Improper Quantization (Only 4 gray levels)
levels = 4
improper = np.floor(image / (256 / levels)) * (256 / levels)
improper = improper.astype(np.uint8)

# Display images
plt.figure(figsize=(12,5))

plt.subplot(1,2,1)
plt.imshow(proper, cmap='gray')
plt.title("Proper Quantization (256 Gray Levels)")
plt.axis('off')

plt.subplot(1,2,2)
plt.imshow(improper, cmap='gray')
plt.title("Improper Quantization (4 Gray Levels)")
plt.axis('off')

plt.show()

# Image Statistics
print("----- Image Statistics -----")
print("Original Gray Levels :", len(np.unique(proper)))
print("Improper Gray Levels :", len(np.unique(improper)))

print("\nConclusion:")
print("1. Proper quantization preserves fine intensity differences.")
print("2. Improper quantization reduces intensity levels drastically.")
print("3. Small structures and tissue boundaries become difficult to distinguish.")
print("4. This may hide abnormalities such as tumors, fractures, or lesions.")
print("5. Therefore, improper quantization can lead to loss of critical diagnostic information.")

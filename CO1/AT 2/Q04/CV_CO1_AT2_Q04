# ==========================================================
# Satellite Image Land Analysis using Computer Vision
# Digital Image Fundamentals & Image Acquisition
# ==========================================================

import cv2
import numpy as np
import matplotlib.pyplot as plt
from skimage import data

# ----------------------------------------------------------
# Load Sample Satellite-like Image
# ----------------------------------------------------------
image = data.astronaut()      # Sample image
image = cv2.cvtColor(image, cv2.COLOR_RGB2BGR)

# Resize to simulate satellite image
satellite = cv2.resize(image, (512,512))

# ----------------------------------------------------------
# Simulate Poor Image Acquisition
# (Blur + Sensor Noise)
# ----------------------------------------------------------
blurred = cv2.GaussianBlur(satellite, (9,9), 4)

noise = np.random.normal(0,20,blurred.shape).astype(np.int16)
poor_image = np.clip(blurred.astype(np.int16)+noise,0,255).astype(np.uint8)

# ----------------------------------------------------------
# Good Image Processing
# ----------------------------------------------------------
gray = cv2.cvtColor(satellite, cv2.COLOR_BGR2GRAY)

edges_good = cv2.Canny(gray,100,200)

# ----------------------------------------------------------
# Poor Image Processing
# ----------------------------------------------------------
gray_poor = cv2.cvtColor(poor_image, cv2.COLOR_BGR2GRAY)

edges_poor = cv2.Canny(gray_poor,100,200)

# ----------------------------------------------------------
# Display Results
# ----------------------------------------------------------
titles = ["Original Satellite Image",
          "Poor Image Acquisition",
          "Good Land Analysis",
          "Poor Land Analysis"]

images = [
    cv2.cvtColor(satellite,cv2.COLOR_BGR2RGB),
    cv2.cvtColor(poor_image,cv2.COLOR_BGR2RGB),
    edges_good,
    edges_poor
]

plt.figure(figsize=(14,8))

for i in range(4):
    plt.subplot(2,2,i+1)
    if i<2:
        plt.imshow(images[i])
    else:
        plt.imshow(images[i], cmap='gray')

    plt.title(titles[i],fontsize=12)
    plt.axis("off")

plt.tight_layout()
plt.show()

# ----------------------------------------------------------
# Accuracy Comparison
# ----------------------------------------------------------
good_edges = np.sum(edges_good > 0)
poor_edges = np.sum(edges_poor > 0)

accuracy = (poor_edges/good_edges)*100

print("========== SATELLITE LAND ANALYSIS REPORT ==========\n")
print("Original Image Edge Pixels :", good_edges)
print("Poor Image Edge Pixels     :", poor_edges)
print("Estimated Analysis Accuracy: {:.2f}%".format(accuracy))

print("\nInfluence of Digital Image Fundamentals")
print("----------------------------------------")
print("✓ Higher resolution preserves land details.")
print("✓ Proper contrast improves boundary detection.")
print("✓ Good sampling produces accurate feature extraction.")

print("\nInfluence of Image Acquisition")
print("-------------------------------")
print("✓ Blur reduces visible land boundaries.")
print("✓ Sensor noise introduces false features.")
print("✓ Better camera sensors improve analysis accuracy.")
print("✓ Proper lighting and acquisition increase reliability.")
